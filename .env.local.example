# ─────────────────────────────────────────────────────────────────────────────
# DevPath (Blue Platypus) — local environment
# Copy this file to `.env.local` and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# When running `supabase start`, the CLI prints the API URL and keys.
# The defaults below match a stock local Supabase stack (safe to commit — they
# are the well-known local demo keys, NOT secrets for any real project).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service-role key — SERVER ONLY. Never exposed to the browser. Used by server
# components / actions and the seed script. This is the stock local key.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJl8emM8b0YQwbsZ-XaW-IB14oG_xs

# ── Auth ─────────────────────────────────────────────────────────────────────
# AUTH_MODE controls login. Leave as "local" to run instantly with a built-in
# dev user (no Auth0 needed). Set to "auth0" to require real Auth0 login.
AUTH_MODE=local

# Optional: a friendly name/email for the local dev user.
LOCAL_USER_EMAIL=you@example.com
LOCAL_USER_NAME=Local Developer

# ── Auth0 (only needed when AUTH_MODE=auth0) ─────────────────────────────────
# Generate a secret with: openssl rand -hex 32
AUTH0_SECRET=
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
